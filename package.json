{
  "name": "brignano",
  "version": "2.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "brignano": "dist/card.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/card.ts",
    "start": "node dist/card.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node dist/card.js --no-prompt",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brignano/card.git"
  },
  "author": "Anthony Brignano <anthonybrignano@gmail.com> (https://brignano.io/)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/brignano/card/issues"
  },
  "homepage": "https://github.com/brignano/card#readme",
  "keywords": [
    "npx",
    "business-card",
    "cli",
    "brignano",
    "resume",
    "vcard"
  ],
  "description": "An interactive terminal business card for Anthony Brignano — run `npx brignano`",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@inquirer/figures": "^2.0.9",
    "@inquirer/prompts": "^8.6.0",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "clipboardy": "^5.3.2",
    "figlet": "^1.11.4",
    "open": "^11.0.1",
    "qrcode-terminal": "^0.12.0",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
